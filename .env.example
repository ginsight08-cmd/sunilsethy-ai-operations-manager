# Add AI provider credentials only when you enable Step 7.
# Never commit real API keys to GitHub.
AI_PROVIDER=
AI_API_KEY=

# n8n production webhook URLs. The workflows must be active.
# Use /webhook/... URLs in deployed apps; /webhook-test/... only works briefly
# while "Listen for test event" is active in the n8n editor.
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/operations-upload
N8N_COPILOT_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/management-copilot
N8N_VAKIL_NOTIFICATION_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/vakil-notification
